# Copy to .env and edit. Every value is optional; the defaults work out of the box.

# Where the server listens. Keep the host on loopback unless you know what you are doing.
TT_HOST=127.0.0.1
TT_PORT=8756

# Override storage locations (defaults live under %LOCALAPPDATA%\TaglishTranscriber).
# TT_DATA_DIR=D:\TaglishTranscriber
# TT_MODELS_DIR=D:\TaglishTranscriber\models

# Explicit FFmpeg locations, only needed if they are not on PATH.
# TT_FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# TT_FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# Longest media accepted, in minutes.
TT_MAX_DURATION_MINUTES=200

# Force the compute backend instead of auto-detecting. auto | cuda | cpu
# TT_DEVICE=auto
